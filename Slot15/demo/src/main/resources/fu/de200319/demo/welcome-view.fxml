<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane alignment="CENTER" prefHeight="400.0" prefWidth="480.0" 
           styleClass="root-pane" stylesheets="@login.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="fu.de200319.demo.WelcomeController">
    <children>
        <VBox alignment="CENTER" maxWidth="380.0" spacing="20.0" styleClass="login-card">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="app-title" text="🎉 ĐĂNG NHẬP THÀNH CÔNG!" />
                <Label fx:id="lblWelcomeMessage" styleClass="form-label" 
                       style="-fx-font-size: 15px; -fx-alignment: center;" text="Xin chào bạn!" />

                <VBox spacing="8.0" styleClass="demo-hint-box">
                    <children>
                        <HBox spacing="10.0">
                            <Label styleClass="hint-title" text="Tài khoản:" />
                            <Label fx:id="lblUsername" styleClass="hint-item" text="-" />
                        </HBox>
                        <HBox spacing="10.0">
                            <Label styleClass="hint-title" text="Vai trò:" />
                            <Label fx:id="lblRole" styleClass="hint-item" text="-" />
                        </HBox>
                        <HBox spacing="10.0">
                            <Label styleClass="hint-title" text="Thời gian:" />
                            <Label fx:id="lblLoginTime" styleClass="hint-item" text="-" />
                        </HBox>
                    </children>
                </VBox>

                <Button fx:id="btnLogout" maxWidth="Infinity" onAction="#handleLogout" 
                        styleClass="btn-primary" text="Đăng xuất" />
            </children>
        </VBox>
    </children>
</StackPane>
